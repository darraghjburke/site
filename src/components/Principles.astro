---
/**
 * A numbered list of principles. Each row is a native <details> for semantics
 * and a no-JS fallback; with JS we intercept the toggle and smoothly animate
 * the row's height (and a gentle fade) with Motion. Animating the <details>
 * element itself — rather than its content — sidesteps the browser's
 * content-hiding of closed <details>, which is what kept the open direction
 * from animating.
 */
interface Principle {
  label: string;
  description: string;
}
interface Props {
  principles: Principle[];
}
const { principles } = Astro.props;
---

<section class="principles">
  <h2>Principles</h2>
  <ol>
    {
      principles.map((p) => (
        <li>
          <details>
            <summary>
              <span class="principle-label">{p.label}</span>
              <span class="marker" aria-hidden="true">
                +
              </span>
            </summary>
            <p class="principle-body">{p.description}</p>
          </details>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .principles {
    margin-top: 3rem;
  }
  .principles h2 {
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .principles ol {
    list-style: none;
    margin-top: 0.75rem;
    border-top: 1px solid var(--hairline);
    counter-reset: principle;
  }
  .principles li {
    counter-increment: principle;
    border-bottom: 1px solid var(--hairline);
  }
  /* The row is what we animate, so clip its overflow as the height changes. */
  .principles details {
    overflow: hidden;
  }
  .principles summary {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    padding: 0.8rem 0;
    cursor: pointer;
    list-style: none;
    color: var(--text);
    transition:
      color 0.25s ease,
      padding-left 0.25s ease;
  }
  /* Hide the native disclosure triangle across browsers. */
  .principles summary::-webkit-details-marker {
    display: none;
  }
  .principles summary::before {
    content: counter(principle, decimal-leading-zero);
    flex: none;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--text-faint);
    transition: color 0.25s ease;
  }
  .principle-label {
    flex: 1;
    font-family: var(--font-serif);
    font-size: 1.05rem;
    line-height: 1.35;
    letter-spacing: -0.005em;
  }
  .marker {
    flex: none;
    color: var(--text-faint);
    transition:
      color 0.25s ease,
      transform 0.25s ease;
  }
  .principles summary:hover {
    color: var(--accent);
    padding-left: 0.4rem;
  }
  .principles summary:hover::before,
  .principles summary:hover .marker {
    color: var(--accent);
  }
  .principles summary:focus-visible {
    outline: none;
    color: var(--accent);
  }
  .principles summary:focus-visible::before,
  .principles summary:focus-visible .marker {
    color: var(--accent);
  }
  /* .is-open is toggled from JS at the moment of intent so the marker rotates
     in step with the height animation (rather than with the [open] attribute,
     which we hold until a close finishes). */
  .principles details.is-open summary {
    color: var(--text-strong);
  }
  .principles details.is-open .marker {
    transform: rotate(45deg);
    color: var(--accent);
  }
  .principles details.is-open summary::before {
    color: var(--accent);
  }
  .principle-body {
    padding: 0 0 1rem 0;
    max-width: 38rem;
    color: var(--text-dim);
  }
</style>

<script>
  import { animate, type AnimationPlaybackControls } from "motion";

  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const DURATION = 0.36;
  const EASE = [0.22, 1, 0.36, 1] as [number, number, number, number];

  document
    .querySelectorAll<HTMLDetailsElement>(".principles details")
    .forEach((d) => {
      const summary = d.querySelector<HTMLElement>("summary");
      const body = d.querySelector<HTMLElement>(".principle-body");
      if (!summary || !body) return;

      let current: AnimationPlaybackControls | null = null;

      const setOpen = (open: boolean) => {
        if (reduce) {
          d.open = open;
          d.classList.toggle("is-open", open);
          return;
        }

        current?.stop();

        // Where we are right now (also catches mid-flight reversals).
        const startH = d.getBoundingClientRect().height;

        if (open) {
          d.open = true; // render the content so it can be measured
          d.classList.add("is-open");
        } else {
          d.classList.remove("is-open");
        }

        // Measure the target height with the content laid out, then pin back.
        d.style.height = "auto";
        const endH = open ? d.getBoundingClientRect().height : summary.offsetHeight;
        d.style.height = `${startH}px`;

        const controls = animate(
          d,
          { height: [`${startH}px`, `${endH}px`] },
          { duration: DURATION, ease: EASE },
        );
        animate(
          body,
          { opacity: open ? [0, 1] : [1, 0] },
          { duration: DURATION * 0.9, ease: EASE },
        );
        current = controls;

        controls.finished
          .then(() => {
            if (current !== controls) return; // superseded by a newer toggle
            if (!open) d.open = false;
            d.style.height = ""; // hand height back to layout (responsive)
            current = null;
          })
          .catch(() => {});
      };

      summary.addEventListener("click", (e) => {
        e.preventDefault();
        setOpen(!d.classList.contains("is-open"));
      });
    });
</script>
