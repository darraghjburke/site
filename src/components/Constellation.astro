---
/**
 * A sparse, slowly-drifting constellation rendered on canvas.
 * Stars wander; hairlines form between nearby stars and fade with distance.
 * Motion is deliberately barely-there. Respects prefers-reduced-motion
 * (renders a single static frame instead of animating).
 */
---

<canvas id="constellation" aria-hidden="true"></canvas>

<style>
  canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
    /* fade the field toward the edges so content stays legible */
    -webkit-mask-image: radial-gradient(
      ellipse 90% 80% at 50% 45%,
      #000 55%,
      transparent 100%
    );
    mask-image: radial-gradient(
      ellipse 90% 80% at 50% 45%,
      #000 55%,
      transparent 100%
    );
  }
</style>

<script>
  const canvas = document.getElementById("constellation") as HTMLCanvasElement;
  const ctx = canvas.getContext("2d")!;
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const LINK_DIST = 150; // px within which stars connect
  const DPR = Math.min(window.devicePixelRatio || 1, 2);

  // Star + link colors come from the active theme's CSS tokens so the
  // constellation inverts along with everything else in light mode.
  let starRGB = "199, 205, 214";
  let lineRGB = "188, 212, 230";
  // Opacity multiplier so the field stays legible on light paper, where the
  // dark-tuned alphas would otherwise wash out. Dark mode keeps this at 1.
  let strength = 1;
  function readThemeColors() {
    const s = getComputedStyle(document.documentElement);
    starRGB = s.getPropertyValue("--star-rgb").trim() || starRGB;
    lineRGB = s.getPropertyValue("--line-rgb").trim() || lineRGB;
    strength = parseFloat(s.getPropertyValue("--field-strength")) || 1;
  }

  type Star = {
    x: number;
    y: number;
    vx: number;
    vy: number;
    r: number;
    bright: boolean;
    phase: number;
  };

  let stars: Star[] = [];
  let w = 0;
  let h = 0;

  function build() {
    w = window.innerWidth;
    h = window.innerHeight;
    canvas.width = w * DPR;
    canvas.height = h * DPR;
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);

    const count = Math.min(120, Math.floor((w * h) / 14000));
    stars = Array.from({ length: count }, () => {
      const bright = Math.random() < 0.12;
      return {
        x: Math.random() * w,
        y: Math.random() * h,
        vx: (Math.random() - 0.5) * 0.06,
        vy: (Math.random() - 0.5) * 0.06,
        r: bright ? 1 + Math.random() * 0.7 : 0.4 + Math.random() * 0.7,
        bright,
        phase: Math.random() * Math.PI * 2,
      };
    });
  }

  function draw(t: number) {
    ctx.clearRect(0, 0, w, h);

    // hairline connections
    for (let i = 0; i < stars.length; i++) {
      for (let j = i + 1; j < stars.length; j++) {
        const a = stars[i];
        const b = stars[j];
        const dx = a.x - b.x;
        const dy = a.y - b.y;
        const d = Math.hypot(dx, dy);
        if (d < LINK_DIST) {
          const o = Math.min(1, (1 - d / LINK_DIST) * 0.16 * strength);
          ctx.strokeStyle = `rgba(${lineRGB}, ${o})`;
          ctx.lineWidth = 0.5;
          ctx.beginPath();
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(b.x, b.y);
          ctx.stroke();
        }
      }
    }

    // stars
    for (const s of stars) {
      // a barely-there twinkle
      const twinkle = reduceMotion ? 0 : Math.sin(t * 0.0005 + s.phase) * 0.15;
      const alpha = Math.min(1, (s.bright ? 0.85 : 0.5) * strength + twinkle);

      if (s.bright) {
        ctx.shadowColor = `rgba(${lineRGB}, 0.6)`;
        ctx.shadowBlur = 6;
        ctx.fillStyle = `rgba(${lineRGB}, ${alpha})`;
      } else {
        ctx.shadowBlur = 0;
        ctx.fillStyle = `rgba(${starRGB}, ${alpha})`;
      }

      ctx.beginPath();
      ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.shadowBlur = 0;
  }

  function step(t: number) {
    for (const s of stars) {
      s.x += s.vx;
      s.y += s.vy;
      // wrap softly around the edges
      if (s.x < -10) s.x = w + 10;
      else if (s.x > w + 10) s.x = -10;
      if (s.y < -10) s.y = h + 10;
      else if (s.y > h + 10) s.y = -10;
    }
    draw(t);
    requestAnimationFrame(step);
  }

  let resizeTimer: number;
  window.addEventListener("resize", () => {
    clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(() => {
      build();
      if (reduceMotion) draw(0);
    }, 150);
  });

  // Re-read colors when the theme changes (manual toggle or system change).
  function onThemeChange() {
    readThemeColors();
    if (reduceMotion) draw(0);
  }
  new MutationObserver(onThemeChange).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["data-theme"],
  });
  window
    .matchMedia("(prefers-color-scheme: light)")
    .addEventListener("change", onThemeChange);

  readThemeColors();
  build();
  if (reduceMotion) {
    draw(0);
  } else {
    requestAnimationFrame(step);
  }
</script>
